{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "store:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "binaries/mongodump", "sidecar": true, "args": true },
        { "name": "binaries/mongorestore", "sidecar": true, "args": true },
        { "name": "binaries/mongoexport", "sidecar": true, "args": true },
        { "name": "binaries/mongoimport", "sidecar": true, "args": true }
      ]
    }
  ]
}
